<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/soil_entry_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Mode Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/bg_card">

        <Button
            android:id="@+id/btnTabManual"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tab_manual_entry"
            android:backgroundTint="@color/primary_emerald"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabTester"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/tab_book_tester"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- MODE 1: Manual Soil Lab Report Form -->
            <LinearLayout
                android:id="@+id/layoutManualForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Tested Soil Parameters"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- pH Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soil pH (e.g. 6.5 - 7.5)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etPh"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="6.8"
                    android:inputType="numberDecimal"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_card"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Nitrogen Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nitrogen N (kg/ha)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etNitrogen"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="140.0"
                    android:inputType="numberDecimal"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_card"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Phosphorus Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phosphorus P (kg/ha)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etPhosphorus"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="42.0"
                    android:inputType="numberDecimal"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_card"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Potassium Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Potassium K (kg/ha)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etPotassium"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="185.0"
                    android:inputType="numberDecimal"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_card"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnSubmitSoilReport"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_submit_soil"
                    android:backgroundTint="@color/primary_emerald"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MODE 2: Soil Tester Booking & Contact Directory -->
            <LinearLayout
                android:id="@+id/layoutTesterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Authorized Local Soil Testers &amp; Labs"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compare testing fees, call lab technicians directly, or order doorstep sample pickup."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- Container where tester cards will be dynamically populated -->
                <LinearLayout
                    android:id="@+id/layoutTesterCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
